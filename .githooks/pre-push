#!/usr/bin/env bash
#
# Отправка блокируется, если проверки не проходят.
#
# set -e   — падаем на первой ошибке;
# set -u   — необъявленная переменная это ошибка, а не пустая строка;
# pipefail — код возврата конвейера берётся от упавшей команды, а не от последней.
#
# Последнее здесь главное: в фазе 1 коммит ушёл при упавшем pnpm verify,
# потому что проверка стояла в конвейере и код возврата взялся от tail.
# Разобрано в docs/08-DECISIONS.md.
set -euo pipefail

echo "pre-push: pnpm verify"

if ! pnpm verify; then
  echo "" >&2
  echo "pre-push: проверки не прошли, отправка отменена." >&2
  echo "Осознанный обход: git push --no-verify" >&2
  exit 1
fi

echo "pre-push: проверки пройдены"
