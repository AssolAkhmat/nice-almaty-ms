#!/usr/bin/env bash
#
# Отправка блокируется, если проверки не проходят.
#
# set -e   — падаем на первой ошибке;
# set -u   — необъявленная переменная это ошибка, а не пустая строка;
# pipefail — код возврата конвейера берётся от упавшей команды, а не от последней.
#
# Последнее здесь главное: в фазе 1 коммит ушёл при упавшем pnpm verify,
# потому что проверка стояла в конвейере и код возврата взялся от tail.
# Разобрано в docs/08-DECISIONS.md.
set -euo pipefail

fail() {
  echo "" >&2
  echo "pre-push: $1 не прошла, отправка отменена." >&2
  echo "Осознанный обход: git push --no-verify" >&2
  exit 1
}

echo "pre-push: pnpm verify"

if ! pnpm verify; then
  fail "проверка"
fi

#
# Сборка проверяется здесь же, потому что `verify` её не делает.
# 24 сентября 2026 клиентский компонент настроек импортировал сервис,
# знающий базу, и утащил драйвер postgres в браузерный бандл: typecheck,
# lint и все тесты остались зелёными, хук пропустил отправку, а боевой
# образ молча не пересобрался — на сервере два дня крутился прежний код.
# CI собирает, значит и хук обязан: иначе «проверки пройдены» означает
# меньше, чем говорит.
#
echo "pre-push: pnpm build"

if ! pnpm build; then
  fail "сборка"
fi

echo "pre-push: проверки пройдены"
