# Обратный прокси перед приложением (docs/01-ARCHITECTURE.md).
#
# Домен приходит из APP_DOMAIN: в файле его нет намеренно, иначе
# он разъедется с APP_URL, по которому приложение строит свои ссылки.
#
# Сертификат Caddy получает и продлевает сам по HTTP-01, для этого
# наружу открыты только 80 и 443. Приложение публикуется на 127.0.0.1
# и снаружи недоступно: до него добирается лишь этот прокси.
{$APP_DOMAIN} {
	encode zstd gzip

	# Полгода вместо года: срок осознанно короткий, пока домен молодой.
	# Ни includeSubDomains, ни preload — они необратимы на месяцы вперёд.
	header Strict-Transport-Security "max-age=15552000"

	reverse_proxy app:3000
}
