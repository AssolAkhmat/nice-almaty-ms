# Цель развёртывания: docker | vercel.
# Единственное место, где код знает о разнице окружений.
DEPLOY_TARGET=docker

# Подключение к PostgreSQL 16. Вместо <пароль> — значение POSTGRES_PASSWORD.
# На Supabase основная строка идёт через пулер (порт 6543, ?pgbouncer=true),
# а DIRECT_DATABASE_URL — прямое подключение (порт 5432) для миграций.
DATABASE_URL=postgres://nice:<пароль>@localhost:5432/nice_almaty
DIRECT_DATABASE_URL=

# Пароль роли nice в контейнере postgres. Значения по умолчанию нет, как
# и у прочих секретов: compose без него не стартует и называет причину.
# Общеизвестный пароль у базы, опубликованной портом на хост, — это дыра.
#   Сгенерировать: openssl rand -base64 24
# Он же подставляется в DATABASE_URL и TEST_DATABASE_URL.
# Переменная действует при создании тома; у существующей базы пароль меняется
# запросом: ALTER USER nice WITH PASSWORD '<пароль>'.
POSTGRES_PASSWORD=

# Порт, на котором compose публикует postgres на хост — только на 127.0.0.1,
# из сети база недоступна.
# Если на машине уже стоит свой PostgreSQL, он займёт 5432 и перехватит
# подключения вместо контейнера — тогда задайте другой порт здесь и в DATABASE_URL.
# Внутри compose сервисы ходят по имени postgres:5432 и от этого не зависят.
POSTGRES_PORT=5432

# Только для `pnpm test:db`: интеграционные тесты на настоящей базе.
# Приложение эту переменную не читает.
TEST_DATABASE_URL=postgres://nice:<пароль>@localhost:5432/nice_almaty

APP_URL=http://localhost:3000

# Секреты. Значений по умолчанию нет — заполняются вручную.
# SESSION_SECRET: не короче 32 символов.
# FIELD_ENCRYPTION_KEY: ровно 32 байта в base64 (AES-256-GCM для ИИН и УДЛ).
#   Сгенерировать: openssl rand -base64 32
# CRON_SECRET: не короче 16 символов, передаётся в заголовке x-cron-secret.
SESSION_SECRET=
FIELD_ENCRYPTION_KEY=
CRON_SECRET=

DEFAULT_LOCALE=ru
TZ=Asia/Almaty

# Хранилище файлов: gdrive | local | supabase.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage

# Печать договора: путь к chromium. puppeteer-core сам браузер не ищет.
# Пусто в Docker — compose подставляет chromium из образа, /usr/bin/chromium-browser.
# Пусто вне Docker — печать честно отказывает, остальное приложение работает.
CHROMIUM_PATH=

# Обязательны при STORAGE_DRIVER=gdrive — три ключа OAuth.
# OAuth от имени владельца диска: у сервисного аккаунта нет своей квоты.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# Необязательна. Пусто — приложение заведёт папку «Nice Almaty» в «Моём диске»
# и напишет её идентификатор в журнал один раз. Папку, созданную владельцем
# в браузере, область drive.file не видит вовсе: чужой id сюда не подходит.
GDRIVE_ROOT_FOLDER_ID=

# Обязательны при STORAGE_DRIVER=supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Web Push: задаётся целиком или не задаётся вовсе.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=

# Канал WhatsApp по умолчанию отключён.
WHATSAPP_WEBHOOK_URL=
