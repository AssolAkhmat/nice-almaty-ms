# зависимости
node_modules/
.pnpm-store/

# сборка
.next/
out/
build/
dist/
*.tsbuildinfo

# тесты
coverage/
playwright-report/
test-results/
test-results-empty/
.playwright/

# окружение: всё, что начинается на .env, кроме образца.
# Шаблон по звёздочке, а не поимённо: редакторы сами делают .env.save,
# .env.bak и .env~, и один такой файл уже уехал в репозиторий с секретами.
.env*
!.env.example

# локальное хранилище файлов: якорь от корня обязателен, иначе шаблон
# проглатывает и src/adapters/storage/
/storage/

# Локальная настройка стека под конкретную машину: лимиты памяти, свои порты.
# Compose подмешивает его автоматически, поэтому он способен ослабить основной
# файл — за этим следит scripts/compose.test.ts.
/docker-compose.override.yml

# платформы
.vercel/
.turbo/

# ОС и редакторы
.DS_Store
Thumbs.db
*.log
